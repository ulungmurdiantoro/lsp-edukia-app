APP_NAME="LSP Edukia"
APP_ENV=production
APP_KEY=                          # Isi dengan: php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://lspedukia.id   # Ganti dengan domain Anda

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=single
LOG_LEVEL=error

# ─── DATABASE ────────────────────────────────────────────────────────────────
# Pilih salah satu: MySQL (direkomendasikan untuk production) atau SQLite

# Opsi 1: MySQL (CREATE DATABASE + user khusus aplikasi di MySQL VPS)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
# JANGAN pernah commit kredensial asli — file ini masuk git. Isi hanya di .env server.
DB_DATABASE=nama_database
DB_USERNAME=nama_user
DB_PASSWORD=

# Opsi 2: SQLite (lebih mudah, file harus ada dan writable)
# DB_CONNECTION=sqlite
# DB_DATABASE=/var/www/lsp-edukia/database/database.sqlite

# Database CBT — sumber sinkronisasi sertifikat (php artisan sertifikat:sync-cbt).
# WAJIB user MySQL read-only terpisah (GRANT SELECT hanya ke view v_sertifikasi_kelulusan).
CBT_DB_HOST=127.0.0.1
CBT_DB_PORT=3306
CBT_DB_DATABASE=cbt_edukia_4
CBT_DB_USERNAME=lsp_edukia_readonly
CBT_DB_PASSWORD=

# ─── ADMIN AWAL (dipakai AdminSeeder) ────────────────────────────────────────
# Kosongkan ADMIN_PASSWORD agar seeder membuat password acak dan menampilkannya sekali.
ADMIN_EMAIL=admin@lspedukia.com
ADMIN_PASSWORD=

# ─── SESSION, CACHE, QUEUE ───────────────────────────────────────────────────
# 'file' — tidak butuh tabel database tambahan (cukup untuk satu server VPS)
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file

# sync = job dijalankan langsung saat request, tanpa queue worker. Untuk memakai worker
# (database/redis), pasang supervisor menjalankan: php artisan queue:work
QUEUE_CONNECTION=sync

# ─── FILESYSTEM ──────────────────────────────────────────────────────────────
FILESYSTEM_DISK=local

# ─── MAIL (opsional) ─────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@your-domain.com"
MAIL_FROM_NAME="LSP Edukia"

# ─── SEO / PENGUKURAN (Fase 1 blueprint) ─────────────────────────────────────
# Paksa HTTPS untuk canonical/OG/sitemap (otomatis aktif saat APP_ENV=production)
APP_FORCE_HTTPS=true

# Google Analytics 4 — Measurement ID dari GA4 (kosongkan jika belum ada)
GOOGLE_ANALYTICS_ID=

# Token verifikasi kepemilikan situs (ambil dari dashboard masing-masing)
GOOGLE_SITE_VERIFICATION=     # Google Search Console (metode "HTML tag")
BING_SITE_VERIFICATION=       # Bing Webmaster Tools

# Profil sosial resmi untuk schema Organization sameAs — pisahkan dengan koma
# Contoh: SOCIAL_PROFILES=https://instagram.com/lspedukia,https://facebook.com/lspedukia
SOCIAL_PROFILES=

# Dashboard GA4 di admin Filament — Property ID GA4 (GA4 → Admin → Property Settings).
# Wajib juga unggah kredensial service account ke: storage/app/analytics/service-account-credentials.json
ANALYTICS_PROPERTY_ID=

# ─── GOOGLE SHEETS — Lamaran Karir ───────────────────────────────────────────
# URL Google Apps Script Web App (tidak butuh service account key).
# Setup: buka spreadsheet → Extensions → Apps Script → paste script → Deploy → Web App
# Execute as: Me, Who has access: Anyone → Copy URL ke sini.
GOOGLE_SHEETS_WEBHOOK_URL=
# OPSIONAL — token rahasia bersama. Bila diisi, isi nilai yang SAMA di Script Properties Apps Script
# (Project Settings → Script Properties → WEBHOOK_TOKEN). Buat dengan: php -r "echo bin2hex(random_bytes(24));"
GOOGLE_SHEETS_WEBHOOK_TOKEN=

# Kontak (opsional — default sudah di config/site.php)
# SITE_PHONE=+6285175479385
# SITE_WHATSAPP=6285175479385
# SITE_EMAIL=edukasi.cendekia@gmail.com
